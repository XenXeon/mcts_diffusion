FROM cleandiffuser:base

# Install Python deps excluding torch/torchvision (already in base as nightly)
# Filter them out to avoid the <2.3.0 constraint overwriting the nightly build
COPY requirements.txt /tmp/requirements.txt
RUN grep -vE "^(torch|torchvision|cython)" /tmp/requirements.txt \
    | pip install --no-cache-dir -r /dev/stdin \
    && pip install --no-cache-dir pytest huggingface_hub

# Install D4RL from source (not on PyPI)
# Pin Cython to 0.29.x — D4RL's Cython extensions don't build with 3.x
RUN pip install --no-cache-dir "cython==0.29.37" \
    && git clone --depth 1 https://github.com/Farama-Foundation/D4RL.git /tmp/d4rl \
    && pip install --no-cache-dir -e /tmp/d4rl

# Pre-compile mujoco_py during image build so runtime containers never need to
# recompile it from scratch.  gcc-11 has a known ICE (segfault) compiling the
# large cymj.c file with -O2 + -fopenmp; OPT overrides the Python distutils
# default so the build succeeds with -O1.
ENV OPT="-O1 -DNDEBUG"
RUN python -c "import mujoco_py; print('mujoco_py compiled OK')"

# Copy source and install cleandiffuser as editable
# At runtime the mount overwrites /workspace, but the .pth file still
# points to /workspace so editable install works with the live mounted code.
WORKDIR /workspace
COPY . /workspace
RUN pip install --no-cache-dir -e .
